{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: build MecanumCar",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-g",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\Car.cpp",
                "${workspaceFolder}\\Motor.cpp",
                "${workspaceFolder}\\Simulation.cpp",
                "-o",
                "${workspaceFolder}\\output\\main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build all MecanumCar source files."
        }
    ],
    "version": "2.0.0"
}